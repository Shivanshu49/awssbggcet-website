# Supabase transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL=
# Supabase direct connection (port 5432) — used by drizzle-kit for migrations.
DIRECT_URL=

# Public site URL, used in email links and inside the QR code.
NEXT_PUBLIC_SITE_URL=

# SMTP (Resend). With no host, emails are skipped and logged.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Cloudflare Turnstile. Unset in `next dev`: Cloudflare's always-pass test keys.
# Any production build needs both, or registration and find-my-pass stay closed.
# To test a production build locally, set Cloudflare's test keys here explicitly.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin sign-in (PR B). ADMIN_EMAILS is comma-separated.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAILS=
