# Database
# Supabase transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL=
# Supabase direct connection (port 5432) — used by drizzle-kit for migrations.
DIRECT_URL=

# App Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Security & QR Token Signing (generate with: openssl rand -hex 32)
QR_SIGNING_SECRET=

# Resend Email Delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@awsbuilders.gcet.edu.in

# WhatsApp Business Cloud API (Official Meta API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=event_registration_confirmation

# Admin Dashboard Access
ADMIN_SECRET=
